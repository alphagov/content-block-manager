<% content_for :page_full_width, true %>
<% content_for :page_title, "Host content metrics" %>
<% content_for :context, "Metrics" %>
<% content_for :title, "Host content metrics" %>

<% if @oldest_refreshed_at %>
  <p class="govuk-body" data-testid="host_content_metrics_last_updated">
    Data no older than: <%= @oldest_refreshed_at.to_fs(:long_ordinal_with_at) %>
  </p>
<% end %>

<%= render Admin::Metrics::HostContentTableComponent.new(documents: @documents, order: @query.order) %>

<%= paginate(@documents, theme: "govuk_paginator") %>
