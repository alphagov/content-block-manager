<%
  items = V2::Document.block_types.keys.map do |type|
    {
      value: type,
      text: type.humanize,
    }
  end
%>

<%= form_with url: v2_documents_path, method: :post do |form| %>
  <%= hidden_field_tag :block_type, "" %>

  <%= render "govuk_publishing_components/components/radio", {
    heading: I18n.t("v2.document.new.title"),
    heading_caption: heading_caption,
    heading_level: 1,
    name: "block_type",
    id: "block_type",
    heading_size: "xl",
    items: items,
    error_message: error_message,
  } %>

  <div class="govuk-button-group">
    <%= render "govuk_publishing_components/components/button", {
      text: I18n.t("buttons.save_and_continue"),
      name: "save_and_continue",
      value: I18n.t("buttons.save_and_continue"),
      type: "submit",
    } %>

    <%= render "govuk_publishing_components/components/button", {
      text: I18n.t("buttons.cancel"),
      name: "cancel",
      value: I18n.t("buttons.cancel"),
      href: v2_documents_path,
      secondary_solid: true,
    } %>
  </div>
<% end %>
