<% content_for :context, I18n.t("v2.time_period_edition.new.context") %>
<% content_for :title, I18n.t("v2.time_period_edition.new.title") %>

<% content_for :back_link do %>
  <%= render "govuk_publishing_components/components/back_link", {
    href: params[:document_id] ? v2_document_path(@document) : new_v2_document_path,
  } %>
<% end %>

<%= render "form", url: params[:document_id] ? v2_document_editions_path(@document) : v2_time_period_editions_path, method: :post %>
